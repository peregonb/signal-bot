{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signal-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // Telegram webhook бота. KV хранит состояние (стратегия, chatId, история, min_hold).
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "c9d67d3b391f42faaccccf75c27dece2",
      "preview_id": "c9d67d3b391f42faaccccf75c27dece2"
    }
  ],
  // Дневной отчёт через 10 минут после закрытия дневной свечи (00:00 UTC):
  // 00:10 UTC = 03:10 Киев летом (UTC+3) / 02:10 зимой (UTC+2).
  "triggers": {
    "crons": ["10 0 * * *"]
  },
  // Метаданные версии деплоя (id, время) — показываются в /status.
  "version_metadata": { "binding": "CF_VERSION" },
  "vars": {
    "SIGNAL_CANDLES": 320
  }
}