{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signal-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // Telegram webhook бота. KV хранит состояние (стратегия, chatId, история, min_hold).
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "c9d67d3b391f42faaccccf75c27dece2",
      "preview_id": "c9d67d3b391f42faaccccf75c27dece2"
    }
  ],
  // Дневной отчёт: попытки каждые 2 минуты 00:05–00:13 UTC (03:05–03:13 Киев летом).
  // Шаг 2 мин (а не 1): KV между городами может отставать до ~60 с — так соседняя попытка
  // гарантированно видит, что отчёт уже ушёл, и не шлёт дубль.
  // Cron Cloudflare выполняется в случайном городе, иногда в стране, которую блокирует Bybit.
  // Неудачные попытки МОЛЧАТ; в Telegram уходит РОВНО ОДНО сообщение — с первой удачной попытки
  // (обычно 00:05), либо одно предупреждение после последней (00:13), если не удалась ни одна.
  // 02:30 UTC — сверка Bybit → архив Binance: пишет, только если сигнал изменился, и БЕЗ ЗВУКА.
  "triggers": {
    "crons": ["5,7,9,11,13 0 * * *", "30 2 * * *"]
  },
  // Метаданные версии деплоя (id, время) — показываются в /status.
  "version_metadata": { "binding": "CF_VERSION" },
  "vars": {
    "SIGNAL_CANDLES": 320
  }
}