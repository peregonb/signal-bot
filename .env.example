# Обязательный секрет (токен бота от @BotFather)
TELEGRAM_BOT_TOKEN=

# Опционально: chat_id для дневного сигнала, если бот ещё не запускали.
# Если не задан, бот возьмёт чат из первого /start.
TELEGRAM_CHAT_ID=

# Опционально: список разрешённых chat_id через запятую.
# Если пусто — отвечает всем, кто напишет.
TELEGRAM_ALLOWED_IDS=

# --- необязательные твики ---
# BINANCE_DATA_API=https://data-api.binance.vision
# SIGNAL_CANDLES=320
# STATE_FILE=state/bot-state.json